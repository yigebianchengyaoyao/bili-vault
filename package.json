{
  "name": "bili-vault",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "BiliVault：面向 Windows 新手的 B 站本地视频下载器，支持大会员 4K",
  "author": "yigebianchengyaoyao",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "pack": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "local.bilivault.app",
    "productName": "BiliVault",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "yt-dlp.exe",
          "ffmpeg.exe"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "BiliVault-${version}-Windows-x64.exe"
    }
  }
}
